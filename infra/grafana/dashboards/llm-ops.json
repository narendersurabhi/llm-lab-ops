{
  "uid": "policy-llm-ops",
  "title": "Policy LLM Ops",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(request_count[1m]))", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "error_rate", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "title": "p95 Latency (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(latency_histogram_bucket[1m])) by (le))", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    },
    {
      "id": 4,
      "title": "TTFT (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(ttft_ms_bucket[1m])) by (le))", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "id": 5,
      "title": "Tokens In/Out",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(tokens_in[1m])", "refId": "A"},
        {"expr": "rate(tokens_out[1m])", "refId": "B"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "id": 6,
      "title": "Tool Success Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "tool_call_success_rate", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    },
    {
      "id": 7,
      "title": "Retrieval Hit Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "retrieval_hit_rate", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}
    },
    {
      "id": 8,
      "title": "Citation Coverage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "citation_coverage", "refId": "A"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}
    }
  ]
}
