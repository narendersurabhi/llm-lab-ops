{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/model_card.schema.json",
  "title": "ModelCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "bundle_version",
    "created_at",
    "model_name",
    "base_model",
    "tuning_method",
    "training_config_hash",
    "dataset_fingerprint",
    "runtime_compatibility",
    "quantization",
    "intended_use",
    "limitations",
    "eval_report_path"
  ],
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "path_eval": {"type": "string", "pattern": "^eval/[^\\s]+$"},
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algo", "value"],
      "properties": {
        "algo": {"type": "string", "enum": ["sha256"]},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "properties": {
    "release_id": {"$ref": "#/$defs/release_id"},
    "bundle_version": {"$ref": "#/$defs/semver"},
    "created_at": {"type": "string", "format": "date-time"},
    "git_sha": {"$ref": "#/$defs/git_sha"},
    "model_name": {"type": "string", "minLength": 1},
    "base_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "tuning_method": {
      "type": "string",
      "enum": ["continued_pretrain", "sft_lora", "dpo", "none"]
    },
    "training_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dataset_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "runtime_compatibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["llama.cpp", "mlx", "vllm"]}
    },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "bits"],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "Q2_K",
            "Q3_K",
            "Q4_K_M",
            "Q5_K_M",
            "Q8_0",
            "fp16",
            "bf16",
            "int8",
            "int4"
          ]
        },
        "bits": {"type": "integer", "minimum": 1, "maximum": 16},
        "group_size": {"type": "integer", "minimum": 1},
        "notes": {"type": "string"}
      }
    },
    "parameters": {"type": "integer", "minimum": 1},
    "license": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "intended_use": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1},
    "eval_report_path": {"$ref": "#/$defs/path_eval"}
  }
}
