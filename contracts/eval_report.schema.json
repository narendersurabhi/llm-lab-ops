{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/eval_report.schema.json",
  "title": "EvalReport",
  "type": "object",
  "required": ["pass", "created_at", "eval_dataset", "metrics", "baseline"],
  "properties": {
    "pass": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"},
    "eval_dataset": {"type": "string"},
    "metrics": {
      "type": "object",
      "required": ["retrieval_recall", "num_queries"],
      "properties": {
        "retrieval_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "num_queries": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["p95_latency_ms", "error_rate", "tool_success_rate"],
      "properties": {
        "p95_latency_ms": {"type": "number", "minimum": 0},
        "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "tool_success_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
