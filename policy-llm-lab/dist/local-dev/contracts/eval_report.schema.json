{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/eval_report.schema.json",
  "title": "EvalReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "baseline_release_id",
    "created_at",
    "eval_dataset",
    "pass",
    "metrics",
    "thresholds",
    "regressions"
  ],
  "$defs": {
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "metric_value": {"type": "number"},
    "metric_delta": {"type": ["number", "null"]},
    "metric_threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number"},
        "max": {"type": "number"}
      },
      "anyOf": [{"required": ["min"]}, {"required": ["max"]}]
    }
  },
  "properties": {
    "release_id": {"$ref": "#/$defs/release_id"},
    "baseline_release_id": {
      "anyOf": [{"$ref": "#/$defs/release_id"}, {"const": "none"}]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "eval_dataset": {"type": "string", "minLength": 1},
    "git_sha": {"$ref": "#/$defs/git_sha"},
    "pass": {"type": "boolean"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_p50_ms",
        "latency_p95_ms",
        "ttft_ms",
        "tokens_per_second",
        "error_rate",
        "tool_call_success_rate",
        "retrieval_hit_rate",
        "citation_coverage"
      ],
      "properties": {
        "latency_p50_ms": {"$ref": "#/$defs/metric_value"},
        "latency_p95_ms": {"$ref": "#/$defs/metric_value"},
        "ttft_ms": {"$ref": "#/$defs/metric_value"},
        "tokens_per_second": {"$ref": "#/$defs/metric_value"},
        "error_rate": {"$ref": "#/$defs/metric_value"},
        "tool_call_success_rate": {"$ref": "#/$defs/metric_value"},
        "retrieval_hit_rate": {"$ref": "#/$defs/metric_value"},
        "citation_coverage": {"$ref": "#/$defs/metric_value"},
        "retrieval_recall": {"$ref": "#/$defs/metric_value"},
        "recall_at_5": {"$ref": "#/$defs/metric_value"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_p50_ms",
        "latency_p95_ms",
        "ttft_ms",
        "tokens_per_second",
        "error_rate",
        "tool_call_success_rate",
        "retrieval_hit_rate",
        "citation_coverage"
      ],
      "properties": {
        "latency_p50_ms": {"$ref": "#/$defs/metric_threshold"},
        "latency_p95_ms": {"$ref": "#/$defs/metric_threshold"},
        "ttft_ms": {"$ref": "#/$defs/metric_threshold"},
        "tokens_per_second": {"$ref": "#/$defs/metric_threshold"},
        "error_rate": {"$ref": "#/$defs/metric_threshold"},
        "tool_call_success_rate": {"$ref": "#/$defs/metric_threshold"},
        "retrieval_hit_rate": {"$ref": "#/$defs/metric_threshold"},
        "citation_coverage": {"$ref": "#/$defs/metric_threshold"},
        "retrieval_recall": {"$ref": "#/$defs/metric_threshold"},
        "recall_at_5": {"$ref": "#/$defs/metric_threshold"}
      }
    },
    "regressions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_p50_ms",
        "latency_p95_ms",
        "ttft_ms",
        "tokens_per_second",
        "error_rate",
        "tool_call_success_rate",
        "retrieval_hit_rate",
        "citation_coverage"
      ],
      "properties": {
        "latency_p50_ms": {"$ref": "#/$defs/metric_delta"},
        "latency_p95_ms": {"$ref": "#/$defs/metric_delta"},
        "ttft_ms": {"$ref": "#/$defs/metric_delta"},
        "tokens_per_second": {"$ref": "#/$defs/metric_delta"},
        "error_rate": {"$ref": "#/$defs/metric_delta"},
        "tool_call_success_rate": {"$ref": "#/$defs/metric_delta"},
        "retrieval_hit_rate": {"$ref": "#/$defs/metric_delta"},
        "citation_coverage": {"$ref": "#/$defs/metric_delta"},
        "retrieval_recall": {"$ref": "#/$defs/metric_delta"},
        "recall_at_5": {"$ref": "#/$defs/metric_delta"}
      }
    },
    "failure_reasons": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"pass": {"const": false}}},
      "then": {"required": ["failure_reasons"]}
    }
  ]
}
