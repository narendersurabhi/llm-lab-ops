{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "required": ["bundle_version", "created_at", "git_sha", "artifacts", "fingerprints"],
  "properties": {
    "bundle_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "git_sha": {"type": "string"},
    "artifacts": {
      "type": "object",
      "required": ["model", "index", "sbom", "checksums", "attestation", "changelog"],
      "properties": {
        "model": {
          "type": "object",
          "required": ["model_card", "eval_report", "model_gguf"],
          "properties": {
            "model_card": {"type": "string"},
            "eval_report": {"type": "string"},
            "model_gguf": {"type": "string"}
          },
          "additionalProperties": false
        },
        "index": {
          "type": "object",
          "required": ["index_sqlite"],
          "properties": {
            "index_sqlite": {"type": "string"}
          },
          "additionalProperties": false
        },
        "sbom": {
          "type": "object",
          "required": ["sbom_json"],
          "properties": {
            "sbom_json": {"type": "string"}
          },
          "additionalProperties": false
        },
        "checksums": {
          "type": "object",
          "required": ["checksums_json"],
          "properties": {
            "checksums_json": {"type": "string"}
          },
          "additionalProperties": false
        },
        "attestation": {
          "type": "object",
          "required": ["attestation_json"],
          "properties": {
            "attestation_json": {"type": "string"}
          },
          "additionalProperties": false
        },
        "changelog": {
          "type": "object",
          "required": ["changelog_md"],
          "properties": {
            "changelog_md": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
